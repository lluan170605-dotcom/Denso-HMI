<Window x:Class="AgvHmiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DENSO-FPT HMI SCADA - EDGE CONTROLLER" 
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        Focusable="True"
        x:Name="RootWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVBAR -->
        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,2" Grid.Row="0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="18" Margin="0,0,8,0" Text="🏭" VerticalAlignment="Center"/>
                    <TextBlock FontSize="14" FontWeight="ExtraBold" Foreground="#000000" Text="DENSO-FPT EDGE HMI SCADA" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- TABS ĐIỀU HƯỚNG CẢM ỨNG HMI -->
                <StackPanel Grid.Column="1" Height="46" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Background="#F1F5F9" BorderBrush="#000000" BorderThickness="2,2,2,0" Content="🗺️ 1. Bản Đồ SCADA Live" FontSize="11" FontWeight="ExtraBold" Foreground="#000000" Height="44" Margin="0,0,4,-2" Padding="14,0" Tag="scada" x:Name="TabBtnScada"/>
                    <Button Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0" Content="🧠 2. Ma Trận AI Dự Báo" FontSize="11" FontWeight="Bold" Foreground="#475569" Height="42" Margin="0,0,4,0" Padding="14,0" Tag="ai" x:Name="TabBtnAi"/>
                    <Button Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0" Content="📦 3. Quản Lý Kho (240 Khay)" FontSize="11" FontWeight="Bold" Foreground="#475569" Height="42" Margin="0,0,4,0" Padding="14,0" Tag="wms" x:Name="TabBtnWms"/>
                    <Button Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0" Content="📈 4. Biểu Đồ Lớn &amp; Dataset" FontSize="11" FontWeight="Bold" Foreground="#475569" Height="42" Margin="0,0,4,0" Padding="14,0" Tag="security" x:Name="TabBtnSecurity"/>
                </StackPanel>

                <!-- TRẠNG THÁI KẾT NỐI -->
                <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1.5" CornerRadius="16" Padding="10,4">
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#15803D" Text="MQTTS Bảo Mật (Port 8883 Online)" x:Name="TxtConnStatus"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VÙNG NỘI DUNG CHÍNH -->
        <Grid Grid.Row="1" Margin="10">

            <!-- TAB 1: BẢN ĐỒ SCADA LIVE & ĐIỀU KHIỂN HMI -->
            <Grid Visibility="Visible" x:Name="ViewScada">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <Border Background="#181F2C" BorderBrush="#000000" BorderThickness="2" ClipToBounds="True" CornerRadius="8" Grid.Row="0">
                        <Viewbox Stretch="Uniform">
                            <Canvas Background="#181F2C" Height="520" Width="780" x:Name="HmiCanvas"/>
                        </Viewbox>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="1" Margin="0,8,0,0" Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="#B45309" Text="📋 NHẬT KÝ VẬN HÀNH &amp; AI DISPATCH"/>
                                <TextBlock FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Text="HÀNG ĐỢI FIFO &amp; CHỐNG ĐỐI ĐẦU 1 CHIỀU"/>
                            </DockPanel>
                            <ListBox Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" Foreground="#334155" Grid.Row="1" x:Name="LstLogs"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="96"/>
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>

                    <!-- DANH SÁCH 12 KỆ HÀNG -->
                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="#000000" Grid.Row="0" Text="📦 TRẠNG THÁI 12 KỆ &amp; THỜI GIAN NGHỈ"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsRackCards">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Cursor="Hand" Margin="0,0,0,6" Padding="8,5" Tag="{Binding Id}" x:Name="BorderRackCard" MouseDown="RackCard_MouseDown">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0">
                                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#000000" Text="{Binding Name}"/>
                                                        <TextBlock FontSize="10" FontWeight="ExtraBold" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" Text="{Binding StatusText}"/>
                                                    </DockPanel>
                                                    
                                                    <ProgressBar Foreground="{Binding StatusColor}" Grid.Row="1" Height="5" Margin="0,3,0,3" Maximum="20" Minimum="0" Value="{Binding Occupied}"/>
                                                    
                                                    <DockPanel Grid.Row="2">
                                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{Binding RestStatusColor}" Text="{Binding RestStatus}"/>
                                                        <TextBlock FontSize="8.5" Foreground="#64748B" HorizontalAlignment="Right" Text="{Binding LastServicedText}"/>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- KHUNG ĐẶT HÀNG ĐỢI ĐA MỤC TIÊU CÓ PHÁT LỆNH -->
                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="1" Margin="0,6,0,0" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <DockPanel Grid.Row="0">
                                <TextBlock FontSize="10.5" FontWeight="ExtraBold" Foreground="#1E3A8A" Text="🎯 HÀNG ĐỢI NHIỀU MỤC TIÊU (FIFO QUEUE)"/>
                                <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right" Text="0 mục tiêu đang chờ" x:Name="TxtActiveOrderCount"/>
                            </DockPanel>

                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontSize="10" FontWeight="Bold" Grid.Column="0" Margin="0,0,4,0" Text="Kệ:" VerticalAlignment="Center"/>
                                <ComboBox FontSize="10" FontWeight="Bold" Grid.Column="1" Height="26" Width="75" x:Name="CboOrderRack"/>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,3,0" Text="Cần:" VerticalAlignment="Center"/>
                                    <TextBox FontSize="11" FontWeight="ExtraBold" Height="26" Text="20" TextAlignment="Center" VerticalContentAlignment="Center" Width="36" x:Name="TxtOrderQuantity"/>
                                    <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,0" Text="/20" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Background="#2563EB" Content="➕ Thêm Lệnh" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" Grid.Column="3" Margin="0,0,3,0" Padding="6,3" x:Name="BtnAddOrder"/>
                                <Button Background="#16A34A" Content="🚀 Phát Lệnh" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" Grid.Column="4" Margin="0,0,3,0" Padding="6,3" x:Name="BtnExecuteOrders"/>
                                <Button Background="#EF4444" Content="Xóa Hết" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Grid.Column="5" Padding="5,3" x:Name="BtnClearOrders"/>
                            </Grid>

                            <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#0284C7" Grid.Row="2" Text="Chế độ thường: Tự động ưu tiên nạp đầy khay (20/20) cho các kệ trống" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="TxtQueueSummary"/>
                        </Grid>
                    </Border>

                    <!-- TELEOP BẢNG ĐIỀU KHIỂN HMI -->
                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="2" Margin="0,6,0,0" Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock FontSize="10" FontWeight="ExtraBold" Foreground="#000000" Text="🎮 ĐIỀU KHIỂN THỦ CÔNG (W/A/S/D | E: BỐC DỠ)"/>
                                <TextBlock FontSize="10.5" FontWeight="ExtraBold" Foreground="#16A34A" HorizontalAlignment="Right" Text="CHẾ ĐỘ: TỰ ĐỘNG" x:Name="TxtCurrentMode"/>
                            </DockPanel>

                            <UniformGrid Columns="5" Grid.Row="1" Margin="0,2">
                                <Button Background="#000000" BorderBrush="#000000" Content="AGV-01" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" x:Name="BtnAgv1"/>
                                <Button Background="#FFFFFF" BorderBrush="#000000" Content="AGV-02" FontSize="9.5" FontWeight="Bold" Foreground="#000000" x:Name="BtnAgv2"/>
                                <Button Background="#FFFFFF" BorderBrush="#000000" Content="AGV-03" FontSize="9.5" FontWeight="Bold" Foreground="#000000" x:Name="BtnAgv3"/>
                                <Button Background="#FFFFFF" BorderBrush="#000000" Content="AGV-04" FontSize="9.5" FontWeight="Bold" Foreground="#000000" x:Name="BtnAgv4"/>
                                <Button Background="#FFFFFF" BorderBrush="#000000" Content="AGV-05" FontSize="9.5" FontWeight="Bold" Foreground="#000000" x:Name="BtnAgv5"/>
                            </UniformGrid>

                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" Content="▲" FontSize="12" FontWeight="Bold" Foreground="#000000" Grid.Column="1" Grid.Row="0" Tag="UP" x:Name="BtnMoveUp"/>
                                    <Button Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" Content="◀" FontSize="12" FontWeight="Bold" Foreground="#000000" Grid.Column="0" Grid.Row="1" Tag="LEFT" x:Name="BtnMoveLeft"/>
                                    <Button Background="#DC2626" BorderBrush="#B91C1C" BorderThickness="1.5" Content="■" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Grid.Column="1" Grid.Row="1" Tag="STOP" x:Name="BtnMoveStop"/>
                                    <Button Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" Content="▶" FontSize="12" FontWeight="Bold" Foreground="#000000" Grid.Column="2" Grid.Row="1" Tag="RIGHT" x:Name="BtnMoveRight"/>
                                    <Button Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" Content="▼" FontSize="12" FontWeight="Bold" Foreground="#000000" Grid.Column="1" Grid.Row="2" Tag="DOWN" x:Name="BtnMoveDown"/>
                                </Grid>

                                <Button Background="#8B5CF6" BorderBrush="#6D28D9" BorderThickness="2" Content="📦 BỐC / DỠ&#x0a;HÀNG (E)" FontSize="10.5" FontWeight="ExtraBold" Foreground="#FFFFFF" Grid.Column="1" Height="62" Margin="10,0,0,0" Width="110" x:Name="BtnManualCargo"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Background="#D97706" BorderBrush="#B45309" BorderThickness="2" Content="LÁI THỦ CÔNG" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" Grid.Column="0" Margin="0,0,3,0" x:Name="BtnToggleMode"/>
                                <Button Background="#DC2626" BorderBrush="#B91C1C" BorderThickness="2" Content="DỪNG KHẨN CẤP" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF" Grid.Column="1" Margin="3,0,0,0" x:Name="BtnEStop"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 2: MA TRẬN DỰ BÁO AI -->
            <Grid Visibility="Collapsed" x:Name="ViewAi">
                <Grid.RowDefinitions>
                    <RowDefinition Height="85"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Columns="4" Grid.Row="0" Margin="0,0,0,10">
                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Margin="0,0,8,0" Padding="12">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#475569" Text="TỔNG KỆ THEO DÕI"/>
                            <TextBlock FontSize="24" FontWeight="ExtraBold" Foreground="#000000" Margin="0,4,0,0" Text="12 Kệ"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="8" Margin="0,0,8,0" Padding="12">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#DC2626" Text="NGUY CƠ QUÁ TẢI (&gt; 80%)"/>
                            <TextBlock FontSize="24" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0" Text="0 Kệ" x:Name="TxtAiOverload"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#D97706" BorderThickness="2" CornerRadius="8" Margin="0,0,8,0" Padding="12">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#D97706" Text="NGUY CƠ CẠN KHAY (&lt; 25%)"/>
                            <TextBlock FontSize="24" FontWeight="ExtraBold" Foreground="#D97706" Margin="0,4,0,0" Text="0 Kệ" x:Name="TxtAiDeplete"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#16A34A" BorderThickness="2" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#16A34A" Text="TRẠNG THÁI AN TOÀN"/>
                            <TextBlock FontSize="24" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,4,0,0" Text="12 Kệ" x:Name="TxtAiSafe"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#000000" Text="📊 BẢNG MA TRẬN XÁC SUẤT DỰ BÁO TỨC THỜI (12 KỆ HÀNG)"/>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Right" Text="HYBRID ENSEMBLE MAX(LSTM, XGBOOST)"/>
                        </DockPanel>
                        <DataGrid AutoGenerateColumns="False" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CanUserAddRows="False" Grid.Row="1" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32" x:Name="GridAiMatrix">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Id}" FontWeight="Bold" Header="MÃ KỆ" Width="90"/>
                                <DataGridTextColumn Binding="{Binding PartName}" FontWeight="Bold" Header="LINH KIỆN" Width="140"/>
                                <DataGridTextColumn Binding="{Binding SlotDisplay}" Header="TỒN KHAY" Width="100"/>
                                <DataGridTextColumn Binding="{Binding OccupancyRate}" Header="LẤP ĐẦY" Width="90"/>
                                <DataGridTextColumn Binding="{Binding LstmProb}" Header="LSTM PROB" Width="110"/>
                                <DataGridTextColumn Binding="{Binding XgbProb}" Header="XGBOOST PROB" Width="120"/>
                                <DataGridTextColumn Binding="{Binding MaxProb}" FontWeight="Bold" Header="KẾT QUẢ MAX()" Width="120"/>
                                <DataGridTextColumn Binding="{Binding Winner}" FontWeight="Bold" Header="MÔ HÌNH THẮNG" Width="130"/>
                                <DataGridTextColumn Binding="{Binding StatusText}" FontWeight="ExtraBold" Header="CẢNH BÁO SCADA" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: QUẢN LÝ KHO WMS (240 KHAY) -->
            <Grid Visibility="Collapsed" x:Name="ViewWms">
                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#000000" Text="📦 MA TRẬN 240 KHAY LINH KIỆN TOÀN NHÀ KHO (12 KỆ × 20 KHAY)"/>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Right" Text="💡 BẤM TRỰC TIẾP Ô VUÔNG ĐỂ THÊM/BỚT KHAY NHANH"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsWmsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Margin="6" Padding="8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="#000000" Text="{Binding HeaderText}"/>
                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" Text="{Binding CountText}"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding MiniSlots}" x:Name="ItemsMiniSlots">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="10"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Background="{Binding Color}" BorderBrush="#000000" BorderThickness="1" Height="20" Margin="1.5" Tag="{Binding TagId}" Width="20" Click="BtnWmsDirectClick"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 4: BIỂU ĐỒ ĐƯỜNG TO (THỰC TẾ VS DỰ ĐOÁN ENSEMBLE) & DATASET -->
            <Grid Visibility="Collapsed" x:Name="ViewSecurity">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="310"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="0" Margin="0,0,0,8" Padding="8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Text="Kệ:" VerticalAlignment="Center"/>
                            <ComboBox FontSize="11" FontWeight="Bold" Height="28" Width="105" x:Name="CboFilterRack"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Text="Từ Ngày:" VerticalAlignment="Center"/>
                            <DatePicker FontSize="10.5" Height="28" Width="118" x:Name="DpFromDate"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Text="Đến Ngày:" VerticalAlignment="Center"/>
                            <DatePicker FontSize="10.5" Height="28" Width="118" x:Name="DpToDate"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Text="Khung Giờ:" VerticalAlignment="Center"/>
                            <ComboBox FontSize="10.5" FontWeight="Bold" Height="28" Width="130" x:Name="CboFilterHour">
                                <ComboBoxItem Content="Cả ngày (00h - 24h)" IsSelected="True"/>
                                <ComboBoxItem Content="Ca Sáng (06h - 14h)"/>
                                <ComboBoxItem Content="Ca Chiều (14h - 22h)"/>
                                <ComboBoxItem Content="Ca Đêm (22h - 06h)"/>
                                <ComboBoxItem Content="1 Giờ gần nhất"/>
                                <ComboBoxItem Content="4 Giờ gần nhất"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Background="#0284C7" Content="Hôm Nay" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" Grid.Column="4" Padding="8,4" x:Name="BtnSetToday"/>
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#1E40AF" Grid.Column="5" HorizontalAlignment="Right" Margin="0,0,10,0" Text="Đang vẽ: RACK-01" VerticalAlignment="Center" x:Name="TxtSlotFilterSummary"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Background="#2563EB" Content="🔄 Nạp Lại" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,4,0" Padding="8,4" x:Name="BtnReloadCsv"/>
                            <Button Background="#000000" Content="📁 File CSV" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Padding="8,4" x:Name="BtnExportCsv"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KHUNG BIỂU ĐỒ ĐƯỜNG TO TOÀN DIỆN -->
                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="1" Margin="0,0,0,8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#000000" Text="📈 BIỂU ĐỒ ĐƯỜNG: THỰC TẾ (LẤP ĐẦY) vs DỰ ĐOÁN ENSEMBLE MAX(LSTM, XGB)" x:Name="TxtChartTitle"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Rectangle Fill="#16A34A" Height="5" Margin="0,0,4,0" VerticalAlignment="Center" Width="20"/>
                                <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,0,18,0" Text="1. Thực Tế (Tồn khay %)" VerticalAlignment="Center"/>
                                <Rectangle Fill="#8B5CF6" Height="5" Margin="0,0,4,0" VerticalAlignment="Center" Width="20"/>
                                <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="#8B5CF6" Text="2. Dự Đoán Ensemble (Max Prob %)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- VÙNG VẼ CANVAS TO RÕ RÀNG -->
                        <Border Background="#0F172A" ClipToBounds="True" CornerRadius="6" Grid.Row="1" Margin="0,6,0,0">
                            <Canvas Height="250" x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- BẢNG DỮ LIỆU DATASET -->
                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Grid.Row="2" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock FontSize="11.5" FontWeight="ExtraBold" Foreground="#000000" Text="📄 BẢNG TOÀN BỘ DỮ LIỆU DỰ ĐOÁN &amp; BIẾN ĐỘNG THEO LỊCH SỬ"/>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Text="0 Bản ghi" x:Name="TxtRecordCount"/>
                        </DockPanel>
                        <DataGrid AutoGenerateColumns="False" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CanUserAddRows="False" Grid.Row="1" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="0,4,0,0" RowHeight="28" x:Name="GridCsvData">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Timestamp}" Header="THỜI GIAN" Width="150"/>
                                <DataGridTextColumn Binding="{Binding RackId}" FontWeight="Bold" Header="MÃ KỆ" Width="85"/>
                                <DataGridTextColumn Binding="{Binding PartName}" FontWeight="Bold" Header="LINH KIỆN" Width="140"/>
                                <DataGridTextColumn Binding="{Binding Occupied}" Header="TỒN (0-20)" Width="85"/>
                                <DataGridTextColumn Binding="{Binding OccupancyRate}" Header="THỰC TẾ (%)" FontWeight="Bold" Width="110"/>
                                <DataGridTextColumn Binding="{Binding LstmProb}" Header="LSTM" Width="90"/>
                                <DataGridTextColumn Binding="{Binding XgbProb}" Header="XGBOOST" Width="95"/>
                                <DataGridTextColumn Binding="{Binding MaxProb}" FontWeight="ExtraBold" Header="DỰ ĐOÁN ENSEMBLE" Width="150"/>
                                <DataGridTextColumn Binding="{Binding Winner}" FontWeight="Bold" Header="THẮNG" Width="90"/>
                                <DataGridTextColumn Binding="{Binding RiskLabel}" FontWeight="ExtraBold" Header="NHÃN RỦI RO" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- POPUP MODAL KHAY -->
            <Grid Background="#80000000" Visibility="Collapsed" x:Name="ModalRackDetail">
                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Center" Padding="16" VerticalAlignment="Center" Width="450">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="#000000" Text="CHI TIẾT KỆ HÀNG" x:Name="TxtModalTitle"/>
                            <Button Background="Transparent" BorderThickness="0" Content="✕" FontSize="13" FontWeight="Bold" Height="26" HorizontalAlignment="Right" Width="26" x:Name="BtnCloseModalTop"/>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#475569" Margin="0,6,0,10" Text="Bấm vào từng ô để thêm hoặc bỏ khay linh kiện:" x:Name="TxtModalDesc"/>
                        <UniformGrid Columns="4" Height="190" Margin="0,0,0,12" x:Name="GridModalSlots"/>
                        <Button Background="#000000" Content="ĐÓNG HỘP THOẠI" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Height="36" x:Name="BtnCloseModalBottom"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
