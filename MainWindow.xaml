<Window x:Class="AgvHmiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DENSO-FPT HMI SCADA - EDGE CONTROLLER" 
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVBAR -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,2" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="🏭" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DENSO-FPT EDGE HMI SCADA" 
                               FontSize="14" FontWeight="ExtraBold" Foreground="#000000" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- TABS ĐIỀU HƯỚNG CẢM ỨNG HMI -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Height="46">
                    <Button x:Name="TabBtnScada" Content="🗺️ 1. Bản Đồ SCADA Live" Tag="scada"
                            Background="#F1F5F9" Foreground="#000000" BorderBrush="#000000" BorderThickness="2,2,2,0" 
                            FontWeight="ExtraBold" FontSize="11" Padding="14,0" Height="44" Margin="0,0,4,-2" Click="SwitchTab_Click"/>
                    <Button x:Name="TabBtnAi" Content="🧠 2. Ma Trận AI Dự Báo" Tag="ai"
                            Background="#FFFFFF" Foreground="#475569" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0" 
                            FontWeight="Bold" FontSize="11" Padding="14,0" Height="42" Margin="0,0,4,0" Click="SwitchTab_Click"/>
                    <Button x:Name="TabBtnWms" Content="📦 3. Quản Lý Kho (240 Khay)" Tag="wms"
                            Background="#FFFFFF" Foreground="#475569" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0" 
                            FontWeight="Bold" FontSize="11" Padding="14,0" Height="42" Margin="0,0,4,0" Click="SwitchTab_Click"/>
                    <Button x:Name="TabBtnSecurity" Content="🛡️ 4. Dataset &amp; Truy Xuất Kệ" Tag="security"
                            Background="#FFFFFF" Foreground="#475569" BorderBrush="Transparent" BorderThickness="1.5,1.5,1.5,0" 
                            FontWeight="Bold" FontSize="11" Padding="14,0" Height="42" Margin="0,0,4,0" Click="SwitchTab_Click"/>
                </StackPanel>

                <!-- TRẠNG THÁI KẾT NỐI -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1.5" CornerRadius="16" Padding="10,4">
                        <TextBlock x:Name="TxtConnStatus" Text="MQTTS Bảo Mật (Port 8883 Online)" FontWeight="Bold" FontSize="11" Foreground="#15803D"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VÙNG NỘI DUNG CHÍNH -->
        <Grid Grid.Row="1" Margin="10">

            <!-- TAB 1: BẢN ĐỒ SCADA LIVE & ĐIỀU KHIỂN HMI -->
            <Grid x:Name="ViewScada" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#181F2C" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="HmiCanvas" Width="780" Height="520" Background="#181F2C"/>
                        </Viewbox>
                    </Border>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Margin="0,8,0,0" Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="📋 NHẬT KÝ VẬN HÀNH &amp; AI DISPATCH" FontWeight="ExtraBold" FontSize="11" Foreground="#B45309"/>
                                <TextBlock Text="CLOSED-LOOP AI &amp; DIRECT MQTT CONTROL" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B"/>
                            </DockPanel>
                            <ListBox x:Name="LstLogs" Grid.Row="1" BorderThickness="0" Background="Transparent" 
                                     FontFamily="Consolas" FontSize="11" Foreground="#334155"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="74"/>
                        <RowDefinition Height="230"/>
                    </Grid.RowDefinitions>

                    <!-- DANH SÁCH 12 KỆ HÀNG -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📦 TRẠNG THÁI 12 KỆ &amp; THỜI GIAN NGHỈ LẤY HÀNG" FontWeight="ExtraBold" FontSize="11" Foreground="#000000"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsRackCards">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="8,5" Cursor="Hand" MouseDown="RackCard_MouseDown" Tag="{Binding Id}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#000000"/>
                                                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontWeight="ExtraBold" FontSize="10" Foreground="{Binding StatusColor}"/>
                                                    </DockPanel>
                                                    
                                                    <ProgressBar Grid.Row="1" Margin="0,3,0,3" Height="5" Minimum="0" Maximum="20" Value="{Binding Occupied}" Foreground="{Binding StatusColor}"/>
                                                    
                                                    <DockPanel Grid.Row="2">
                                                        <TextBlock Text="{Binding RestStatus}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding RestStatusColor}"/>
                                                        <TextBlock Text="{Binding LastServicedText}" HorizontalAlignment="Right" FontSize="8.5" Foreground="#64748B"/>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- KHUNG ĐẶT LỆNH ĐIỀU PHỐI MỤC TIÊU (NEW) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Margin="0,6,0,0" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="🎯 ĐẶT LỆNH MỤC TIÊU SỐ LƯỢNG KỆ" FontWeight="ExtraBold" FontSize="10.5" Foreground="#1E3A8A"/>
                                <TextBlock x:Name="TxtActiveOrderInfo" Text="Chưa có lệnh" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#D97706"/>
                            </DockPanel>

                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Kệ:" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CboOrderRack" Grid.Column="1" Width="82" Height="26" FontSize="10" FontWeight="Bold"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Cần:" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="TxtOrderQuantity" Width="42" Height="26" Text="12" FontSize="11" FontWeight="ExtraBold" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="/20" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <Button x:Name="BtnSendOrder" Grid.Column="3" Content="🚀 Phát Lệnh" Background="#2563EB" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="10" Padding="8,3" Margin="0,0,4,0" Click="BtnSendOrder_Click"/>
                                <Button x:Name="BtnCancelOrder" Grid.Column="4" Content="Hủy" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="6,3" Click="BtnCancelOrder_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TELEOP BẢNG ĐIỀU KHIỂN HMI -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Margin="0,6,0,0" Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock Text="🎮 ĐIỀU KHIỂN THỦ CÔNG" FontWeight="ExtraBold" FontSize="10" Foreground="#000000"/>
                                <TextBlock x:Name="TxtCurrentMode" Text="CHẾ ĐỘ: TỰ ĐỘNG" HorizontalAlignment="Right" FontWeight="ExtraBold" FontSize="10.5" Foreground="#16A34A"/>
                            </DockPanel>

                            <UniformGrid Grid.Row="1" Columns="5" Margin="0,2">
                                <Button x:Name="BtnAgv1" Content="AGV-01" FontWeight="Bold" FontSize="9.5" Background="#000000" Foreground="#FFFFFF" BorderBrush="#000000" Click="BtnSelectAgv_Click"/>
                                <Button x:Name="BtnAgv2" Content="AGV-02" FontWeight="Bold" FontSize="9.5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" Click="BtnSelectAgv_Click"/>
                                <Button x:Name="BtnAgv3" Content="AGV-03" FontWeight="Bold" FontSize="9.5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" Click="BtnSelectAgv_Click"/>
                                <Button x:Name="BtnAgv4" Content="AGV-04" FontWeight="Bold" FontSize="9.5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" Click="BtnSelectAgv_Click"/>
                                <Button x:Name="BtnAgv5" Content="AGV-05" FontWeight="Bold" FontSize="9.5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" Click="BtnSelectAgv_Click"/>
                            </UniformGrid>

                            <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="1" Content="▲" FontSize="14" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" BorderThickness="2" Click="BtnManualMove_Click" Tag="UP"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="◀" FontSize="14" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" BorderThickness="2" Click="BtnManualMove_Click" Tag="LEFT"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="■" FontSize="14" FontWeight="Bold" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C" BorderThickness="2" Click="BtnManualMove_Click" Tag="STOP"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="▶" FontSize="14" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" BorderThickness="2" Click="BtnManualMove_Click" Tag="RIGHT"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="▼" FontSize="14" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#000000" BorderThickness="2" Click="BtnManualMove_Click" Tag="DOWN"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnToggleMode" Grid.Column="0" Content="LÁI THỦ CÔNG" Margin="0,0,3,0" 
                                        Background="#D97706" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="10" BorderBrush="#B45309" BorderThickness="2" Click="BtnToggleMode_Click"/>
                                <Button x:Name="BtnEStop" Grid.Column="1" Content="DỪNG KHẨN CẤP" Margin="3,0,0,0" 
                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="10" BorderBrush="#B91C1C" BorderThickness="2" Click="BtnEStop_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 2: MA TRẬN DỰ BÁO AI -->
            <Grid x:Name="ViewAi" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="85"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TỔNG KỆ THEO DÕI" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="12 Kệ" FontSize="24" FontWeight="ExtraBold" Foreground="#000000" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="NGUY CƠ QUÁ TẢI (&gt; 80%)" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                            <TextBlock x:Name="TxtAiOverload" Text="0 Kệ" FontSize="24" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#D97706" BorderThickness="2" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="NGUY CƠ CẠN KHAY (&lt; 25%)" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                            <TextBlock x:Name="TxtAiDeplete" Text="0 Kệ" FontSize="24" FontWeight="ExtraBold" Foreground="#D97706" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" BorderBrush="#16A34A" BorderThickness="2" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="TRẠNG THÁI AN TOÀN" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                            <TextBlock x:Name="TxtAiSafe" Text="12 Kệ" FontSize="24" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="📊 BẢNG MA TRẬN XÁC SUẤT DỰ BÁO TỨC THỜI (12 KỆ HÀNG)" FontWeight="ExtraBold" FontSize="12" Foreground="#000000"/>
                            <TextBlock Text="HYBRID ENSEMBLE MAX(LSTM, XGBOOST)" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                        </DockPanel>
                        <DataGrid x:Name="GridAiMatrix" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                                  BorderThickness="1" BorderBrush="#CBD5E1" Background="#FFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ KỆ" Binding="{Binding Id}" FontWeight="Bold" Width="90"/>
                                <DataGridTextColumn Header="LINH KIỆN" Binding="{Binding PartName}" FontWeight="Bold" Width="140"/>
                                <DataGridTextColumn Header="TỒN KHAY" Binding="{Binding SlotDisplay}" Width="100"/>
                                <DataGridTextColumn Header="LẤP ĐẦY" Binding="{Binding OccupancyRate}" Width="90"/>
                                <DataGridTextColumn Header="LSTM PROB" Binding="{Binding LstmProb}" Width="110"/>
                                <DataGridTextColumn Header="XGBOOST PROB" Binding="{Binding XgbProb}" Width="120"/>
                                <DataGridTextColumn Header="KẾT QUẢ MAX()" Binding="{Binding MaxProb}" FontWeight="Bold" Width="120"/>
                                <DataGridTextColumn Header="MÔ HÌNH THẮNG" Binding="{Binding Winner}" FontWeight="Bold" Width="130"/>
                                <DataGridTextColumn Header="CẢNH BÁO SCADA" Binding="{Binding StatusText}" FontWeight="ExtraBold" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: QUẢN LÝ KHO WMS (240 KHAY) -->
            <Grid x:Name="ViewWms" Visibility="Collapsed">
                <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="📦 MA TRẬN 240 KHAY LINH KIỆN TOÀN NHÀ KHO (12 KỆ × 20 KHAY)" FontWeight="ExtraBold" FontSize="12" Foreground="#000000"/>
                            <TextBlock Text="💡 BẤM TRỰC TIẾP Ô VUÔNG ĐỂ THÊM/BỚT KHAY NHANH" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                        </DockPanel>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsWmsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="6" Padding="8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding HeaderText}" FontWeight="ExtraBold" FontSize="11" Foreground="#000000"/>
                                                    <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#2563EB"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding MiniSlots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="10"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="20" Height="20" Margin="1.5"
                                                                    Background="{Binding Color}" BorderBrush="#000000" BorderThickness="1"
                                                                    Click="BtnToggleWmsSlot_Click" Tag="{Binding TagId}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 4: TOÀN BỘ BẢNG DỰ ĐOÁN + TRUY XUẤT THEO NGÀY THÁNG NĂM & GIỜ -->
            <Grid x:Name="ViewSecurity" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="185"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="8,0" Margin="0,0,0,8">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Kệ:" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CboFilterRack" Width="105" Height="28" FontSize="11" FontWeight="Bold" SelectionChanged="FilterSelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Từ Ngày:" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker x:Name="DpFromDate" Width="118" Height="28" FontSize="10.5" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Đến Ngày:" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker x:Name="DpToDate" Width="118" Height="28" FontSize="10.5" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Khung Giờ:" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CboFilterHour" Width="130" Height="28" FontSize="10.5" FontWeight="Bold" SelectionChanged="FilterSelectionChanged">
                                <ComboBoxItem Content="Cả ngày (00h - 24h)" IsSelected="True"/>
                                <ComboBoxItem Content="Ca Sáng (06h - 14h)"/>
                                <ComboBoxItem Content="Ca Chiều (14h - 22h)"/>
                                <ComboBoxItem Content="Ca Đêm (22h - 06h)"/>
                                <ComboBoxItem Content="1 Giờ gần nhất"/>
                                <ComboBoxItem Content="4 Giờ gần nhất"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="4" Content="Hôm Nay" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" Padding="8,4" Click="BtnSetToday_Click"/>

                        <TextBlock x:Name="TxtSlotFilterSummary" Grid.Column="5" Text="Đang vẽ xu hướng: RACK-01" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄 Nạp Lại" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="8,4" Margin="0,0,4,0" Click="BtnReloadCsv_Click"/>
                            <Button Content="📁 File CSV" Background="#000000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="8,4" Click="BtnExportCsv_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock x:Name="TxtChartTitle" Text="📈 BIỂU ĐỒ XÁC SUẤT AI (LSTM vs XGBOOST) CỦA KỆ ĐƯỢC CHỌN" FontWeight="ExtraBold" FontSize="11" Foreground="#000000"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Rectangle Width="14" Height="4" Fill="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="XGBoost Prob" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Rectangle Width="14" Height="4" Fill="#2563EB" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LSTM Prob" FontSize="10" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" ClipToBounds="True" Margin="0,4,0,0">
                            <Canvas x:Name="ChartCanvas" Height="130"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="📄 BẢNG TOÀN BỘ DỮ LIỆU DỰ ĐOÁN &amp; BIẾN ĐỘNG (RUNTIME_TRAINING_DATA.CSV)" FontWeight="ExtraBold" FontSize="11.5" Foreground="#000000"/>
                            <TextBlock x:Name="TxtRecordCount" Text="0 Bản ghi" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                        </DockPanel>

                        <DataGrid x:Name="GridCsvData" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28"
                                  BorderThickness="1" BorderBrush="#CBD5E1" Background="#FFFFFF" Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding Timestamp}" Width="150"/>
                                <DataGridTextColumn Header="MÃ KỆ" Binding="{Binding RackId}" FontWeight="Bold" Width="85"/>
                                <DataGridTextColumn Header="LINH KIỆN" Binding="{Binding PartName}" FontWeight="Bold" Width="140"/>
                                <DataGridTextColumn Header="TỒN" Binding="{Binding Occupied}" Width="65"/>
                                <DataGridTextColumn Header="LẤP ĐẦY" Binding="{Binding OccupancyRate}" Width="85"/>
                                <DataGridTextColumn Header="LSTM" Binding="{Binding LstmProb}" Width="90"/>
                                <DataGridTextColumn Header="XGBOOST" Binding="{Binding XgbProb}" Width="95"/>
                                <DataGridTextColumn Header="MAX PROB" Binding="{Binding MaxProb}" FontWeight="Bold" Width="95"/>
                                <DataGridTextColumn Header="THẮNG" Binding="{Binding Winner}" FontWeight="Bold" Width="90"/>
                                <DataGridTextColumn Header="NHÃN RỦI RO" Binding="{Binding RiskLabel}" FontWeight="ExtraBold" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- POPUP MODAL: CHI TIẾT 20 KHAY KHI CHẠM VÀO KỆ -->
            <Grid x:Name="ModalRackDetail" Visibility="Collapsed" Background="#80000000">
                <Border Width="450" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="2" CornerRadius="8" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TxtModalTitle" Text="CHI TIẾT KỆ HÀNG" FontWeight="ExtraBold" FontSize="13" Foreground="#000000"/>
                            <Button Content="✕" Width="26" Height="26" FontWeight="Bold" FontSize="13" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="CloseModal_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtModalDesc" Text="Bấm vào từng ô để thêm hoặc bỏ khay linh kiện:" FontSize="11" Foreground="#475569" Margin="0,6,0,10"/>
                        <UniformGrid x:Name="GridModalSlots" Columns="4" Height="190" Margin="0,0,0,12"/>
                        <Button Content="ĐÓNG HỘP THOẠI" Height="36" FontWeight="Bold" FontSize="11" Background="#000000" Foreground="#FFFFFF" Click="CloseModal_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>